# Base URL of the GAMEFOWL Laravel backend (no trailing slash).
#
# Pick the value that matches where you're running the app:
#   iOS Simulator:      http://localhost:8000/api/v1
#   Android Emulator:   http://10.0.2.2:8000/api/v1
#   Physical device
#   via Expo Go:        http://<YOUR-PC-LAN-IP>:8000/api/v1  (e.g. 192.168.1.20)
#
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
