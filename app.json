{
  "expo": {
    "name": "Gamefowl-MobileApp",
    "slug": "Gamefowl-MobileApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gamefowl.mobileapp",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/app_icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-video",
      [
        "./plugins/withCleartextHosts",
        {
          "hosts": [
            "201.18.208.199"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app_icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#123122"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ad800625-cc17-4fab-9a63-02e0b3025bb5"
      }
    },
    "owner": "laradevv"
  }
}
